# Repo-wide ignores. Frontend-only rules live in app/frontend/.gitignore.

# Secrets and local settings: .env is written by scripts/setup.py; only the example is shared
.env
.env.*
!.env.example

# cognee's local storage when it runs inside the backend (databases, graph, vectors, logs)
.cognee_data/
.cognee_system/
logs/
.dlt/

# Python (app/backend, scripts, tests)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
