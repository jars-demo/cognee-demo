# cognee-demo settings. Easiest: run `python scripts/setup.py`, which writes .env for you.
# Or copy this file to .env and uncomment what you need. With no .env at all, the Docker stack
# runs with no API key.

AUTO_FEEDBACK=false
ENABLE_BACKEND_ACCESS_CONTROL=false
TELEMETRY_DISABLED=1

###############################################################################
# Where the backend finds cognee when the backend runs on your machine
#   - not set           cognee runs inside the backend process (option 3, "Local")
#   - localhost:8001    the cognee container from docker-compose.yml (option 2, "Develop")
#   - a cloud URL       Cognee Cloud (option 4); create the key on the API Keys page at
#                       https://platform.cognee.ai
# Inside Docker this is ignored: the backend container always uses http://cognee:8000.
###############################################################################

#COGNEE_SERVICE_URL="http://localhost:8001"
#COGNEE_SERVICE_URL="https://your-tenant.aws.cognee.ai"
#COGNEE_API_KEY="..."

###############################################################################
# Optional: free Groq key for LLM-built graphs and LLM-written answers
# Get one at https://console.groq.com/keys. Used by the cognee container, or by the backend
# when cognee runs inside it. Keep the EMBEDDING_* lines: Groq has no embedding models, and
# without them cognee would fall back to OpenAI embeddings.
###############################################################################

#LLM_API_KEY="gsk_..."
#LLM_PROVIDER="custom"
#LLM_MODEL="groq/llama-3.3-70b-versatile"
#LLM_ENDPOINT="https://api.groq.com/openai/v1"
#EMBEDDING_PROVIDER="fastembed"
#EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
#EMBEDDING_DIMENSIONS=384
